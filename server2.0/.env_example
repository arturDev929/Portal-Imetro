# Servidor
PORT=8081

# Banco de dados MySQL
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=seu_usuario_mysql
MYSQLPASSWORD=substitua_pela_senha_do_mysql
MYSQLDATABASE=imetro

# Alternativa suportada: use DB_* no lugar de MYSQL_* (não configure os dois conjuntos).
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=seu_usuario_mysql
# DB_PASSWORD=substitua_pela_senha_do_mysql
# DB_DATABASE=imetro

# Gere um segredo aleatório forte e exclusivo para este ambiente.
JWT_SECRET=substitua_por_um_segredo_aleatorio_forte

# Gmail: use uma senha de app, não a senha normal da conta.
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=substitua_pela_senha_de_app

# URLs públicas opcionais usadas em links de arquivos e emails
APP_URL=http://localhost:3000
# BASE_URL=http://localhost:3000
