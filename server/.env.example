# Configurações do Banco de Dados MySQL
# Opção 1: Usando variáveis padrão do MySQL
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=seu_usuario_mysql
MYSQLPASSWORD=sua_senha_mysql
MYSQLDATABASE=imetro

# Opção 2: Usando variáveis customizadas
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_DATABASE=imetro

# Porta do servidor backend
PORT=8081

# Configurações de email (opcional - para funcionalidades de notificação)
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_app